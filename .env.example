# Server-only Google CRM ingest for website contact submissions.
# Never prefix these with NEXT_PUBLIC_. The browser must not receive them.
# A contact submission succeeds only when this ingest is enabled and Apps Script
# confirms the write. CRM_INGEST_ENABLED must be exactly true. Any other value
# fails the submission closed and stores no lead.
# Other existing server env vars used by this site are unchanged and are not listed here.
#
# Vercel Production uses these same four names. Do not commit production values.
# Production must set CRM_INGEST_ENABLED=true. Any other production value rejects
# contact submissions instead of reporting success.
# CRM_INGEST_URL is the Apps Script Web App /exec URL for that environment.
# CRM_INGEST_SECRET is the HMAC secret shared with that Apps Script deployment.
# Do not reuse a secret across environments.

CRM_INGEST_ENABLED=false
CRM_INGEST_URL=https://script.google.com/macros/s/YOUR_DEV_DEPLOYMENT_ID/exec
CRM_INGEST_SECRET=replace-with-apps-script-dev-secret
CRM_INGEST_TIMEOUT_MS=15000
